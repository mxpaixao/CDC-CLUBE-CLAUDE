{
  "name": "@cdc/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "start:worker": "node dist/src/worker.js",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch dist/src/main.js",
    "dev:worker": "node --watch dist/src/worker.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:dev": "prisma migrate dev",
    "seed": "node dist/prisma/seed.js"
  },
  "prisma": {
    "seed": "node dist/prisma/seed.js"
  },
  "dependencies": {
    "@cdc/rules": "workspace:*",
    "@cdc/shared": "workspace:*",
    "@nestjs/bullmq": "11.0.4",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/swagger": "11.2.0",
    "@prisma/client": "6.16.3",
    "argon2": "0.44.0",
    "bullmq": "5.61.0",
    "cookie-parser": "1.4.7",
    "csv-parse": "6.1.0",
    "exceljs": "4.4.0",
    "helmet": "8.1.0",
    "ioredis": "5.8.1",
    "multer": "2.0.2",
    "nestjs-pino": "4.4.1",
    "pino": "9.13.1",
    "pino-http": "10.5.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76",
    "luxon": "3.7.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.6",
    "@swc/core": "1.13.5",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/multer": "2.0.0",
    "@types/node": "22.18.8",
    "@types/qrcode": "1.5.5",
    "@types/supertest": "6.0.3",
    "pino-pretty": "13.1.1",
    "prisma": "6.16.3",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "unplugin-swc": "1.5.7",
    "vitest": "3.2.4",
    "@types/luxon": "3.7.1"
  }
}
