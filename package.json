{
  "name": "clube-cdc",
  "private": true,
  "version": "0.1.0",
  "description": "Clube CDC — programa de fidelidade e comunidade da Casa das Correias",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "build:libs": "pnpm --filter @cdc/shared build && pnpm --filter @cdc/rules build",
    "test": "pnpm build:libs && pnpm -r --workspace-concurrency=1 test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2"
  }
}
