# console (desenvolvimento) | whatsapp
NOTIFICADOR=console
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
BACKUP_PASTA=./backups
BACKUP_RETENCAO_DIAS=30
BACKUP_HORA=02:30
LOG_LEVEL=info
