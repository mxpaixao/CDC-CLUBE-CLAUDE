# Copie para .env na raiz e preencha. NUNCA versione o .env.
POSTGRES_USER=cdc
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=clube_cdc
# 64+ caracteres aleatórios: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=
